# FitAI Coach & SATHI AI Environment Configuration

# Server Port (Render sets this automatically)
PORT=3000
NODE_ENV=production

# Permitted CORS Origins (comma-separated list of allowed frontend domains)
# When frontend is on GitHub Pages:
CORS_ORIGIN=https://shovamdestroyer.github.io,http://localhost:3000,http://127.0.0.1:3000

# Server-Side Google Gemini API Key for SATHI AI Chatbot
# NOTE: Never commit this key to GitHub or expose it in frontend browser code!
# (Optional: If omitted, SATHI automatically uses its deterministic calculation & built-in clinical fallback engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud Authentication & PostgreSQL Database Configuration (Optional)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
